        </visual>
        <collision>
            <origin xyz="0 -0.1 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.2 0.15" />
            </geometry>
        </collision>
    </link>
    <joint name="RightHip_RightUpperLeg" type="revolute">
