<robot name = "robot">
    <link name="Torso">
        <inertial>
            <origin xyz="0 0 1.5" rpy="0 0 0"/>
            <mass value="1" />
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
        <visual>
            <origin xyz="0 0 1.5" rpy="0 0 0"/>
            <geometry>
                <box size="0.4 0.3 0.8" />
            </geometry>
            <material name="Cyan">
                <color rgba="0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 1.5" rpy="0 0 0"/>
            <geometry>
                <box size="0.4 0.3 0.8" />
            </geometry>
        </collision>
    </link>
    <joint name="Torso_LeftHip" type="revolute">
       <parent link="Torso"/>
       <child  link="LeftHip"/>
       <origin rpy="0 0 0" xyz="0 0.2 0.8" />
       <axis xyz="0 1 0"/>
       <limit effort="0.0" lower="-3.14159" upper="3.14159" velocity="0.0"/>
    </joint>
    <link name="LeftHip">
        <inertial>
            <origin xyz="0 0.1 0" rpy="0 0 0"/>
            <mass value="1" />
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
        <visual>
            <origin xyz="0 0.1 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.2 0.15" />
            </geometry>
            <material name="Cyan">
                <color rgba="0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0.1 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.2 0.15" />
            </geometry>
        </collision>
    </link>
    <joint name="LeftHip_LeftUpperLeg" type="revolute">
       <parent link="LeftHip"/>
       <child  link="LeftUpperLeg"/>
       <origin rpy="0 0 0" xyz="0 0.2 0" />
       <axis xyz="1 0 0"/>
       <limit effort="0.0" lower="-3.14159" upper="3.14159" velocity="0.0"/>
    </joint>
    <link name="LeftUpperLeg">
        <inertial>
            <origin xyz="0 0 -0.4" rpy="0 0 0"/>
            <mass value="1" />
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
        <visual>
            <origin xyz="0 0 -0.4" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.15 0.8" />
            </geometry>
            <material name="Cyan">
                <color rgba="0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -0.4" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.15 0.8" />
            </geometry>
        </collision>
    </link>
    <joint name="LeftUpperLeg_LeftLowerLeg" type="revolute">
       <parent link="LeftUpperLeg"/>
       <child  link="LeftLowerLeg"/>
       <origin rpy="0 0 0" xyz="0 0 -0.8" />
       <axis xyz="1 0 0"/>
       <limit effort="0.0" lower="-3.14159" upper="3.14159" velocity="0.0"/>
    </joint>
    <link name="LeftLowerLeg">
        <inertial>
            <origin xyz="0 0 -0.3" rpy="0 0 0"/>
            <mass value="1" />
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
        <visual>
            <origin xyz="0 0 -0.3" rpy="0 0 0"/>
            <geometry>
                <box size="0.12 0.12 0.6" />
            </geometry>
            <material name="Cyan">
                <color rgba="0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -0.3" rpy="0 0 0"/>
            <geometry>
                <box size="0.12 0.12 0.6" />
            </geometry>
        </collision>
    </link>
    <joint name="LeftLowerLeg_LeftFoot" type="fixed">
       <parent link="LeftLowerLeg"/>
       <child  link="LeftFoot"/>
       <origin rpy="0 0 0" xyz="0 0 -0.6" />
       <axis xyz="0 1 0"/>
       <limit effort="0.0" lower="-3.14159" upper="3.14159" velocity="0.0"/>
    </joint>
    <link name="LeftFoot">
        <inertial>
            <origin xyz="0.1 0 -0.05" rpy="0 0 0"/>
            <mass value="1" />
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
        <visual>
            <origin xyz="0.1 0 -0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.15 0.1" />
            </geometry>
            <material name="Cyan">
                <color rgba="0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.1 0 -0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.15 0.1" />
            </geometry>
        </collision>
    </link>
    <joint name="Torso_RightHip" type="revolute">
